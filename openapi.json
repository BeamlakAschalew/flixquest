{
  "openapi": "3.0.3",
  "info": {
    "title": "FlixQuest Scraper API",
    "version": "2.0.0",
    "description": "Exhaustive OpenAPI specification for FlixQuest Scraper API v2, designed for integration with Flutter applications."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Providers",
      "description": "Operations for listing and managing scraper provider states."
    },
    {
      "name": "Streams",
      "description": "Operations for scraping movie and TV episode stream links."
    },
    {
      "name": "Configuration",
      "description": "Runtime playback configuration consumed by FlixQuest clients."
    },
    {
      "name": "DLHD",
      "description": "Live channel, HLS extraction, and categorized EPG operations for DLHD."
    },
    {
      "name": "Proxy",
      "description": "Stream proxy pass-through endpoint for video playback."
    }
  ],
  "paths": {
    "/api/v2/intro": {
      "get": {
        "summary": "Get Branded Intro Configuration",
        "description": "Returns the optional branded video played before official streams.",
        "operationId": "getIntroConfig",
        "tags": ["Configuration"],
        "responses": {
          "200": {
            "description": "Intro configuration retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntroConfigResponse"
                }
              }
            }
          },
          "500": {
            "description": "The server intro environment variables are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/providers": {
      "get": {
        "summary": "List Available Providers",
        "description": "Retrieves the list of active (and optionally disabled) video scraper providers.",
        "operationId": "getProviders",
        "tags": ["Providers"],
        "parameters": [
          {
            "name": "all",
            "in": "query",
            "required": false,
            "description": "Set to 'true' to include disabled providers in the response.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "includeDisabled",
            "in": "query",
            "required": false,
            "description": "Alias for 'all'. Set to 'true' to include disabled providers.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "fProxy",
            "in": "query",
            "required": false,
            "description": "Forward proxy configuration mode or proxy URL.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider list retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/providers/status": {
      "get": {
        "summary": "Get Provider Stream Health",
        "description": "Returns the latest persisted fifteen-minute stream check for every enabled provider.",
        "operationId": "getProviderHealthStatus",
        "tags": ["Providers"],
        "responses": {
          "200": {
            "description": "The latest provider health snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderHealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "No provider health snapshot is available yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/providers/{id}": {
      "patch": {
        "summary": "Update Provider Enabled State",
        "description": "Enables or disables a specific scraper provider by ID.",
        "operationId": "updateProviderStatus",
        "tags": ["Providers"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The unique provider identifier (e.g. 'vixsrc').",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProviderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider status successfully updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateProviderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/providers/{id}/toggle": {
      "post": {
        "summary": "Toggle Provider Status",
        "description": "Toggles the enabled status of a provider, or sets it explicitly if provided in the body.",
        "operationId": "toggleProviderStatus",
        "tags": ["Providers"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The unique provider identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToggleProviderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider status successfully toggled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateProviderResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/stream-movie": {
      "get": {
        "summary": "Get Movie Stream Links",
        "description": "Fetches validated playback stream links for a movie by TMDB ID using a selected provider.",
        "operationId": "getMovieStream",
        "tags": ["Streams"],
        "parameters": [
          {
            "name": "tmdbId",
            "in": "query",
            "required": true,
            "description": "The TMDB ID of the movie (e.g. '556574').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": true,
            "description": "The provider identifier to scrape streams from (e.g. 'vixsrc').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "proxy",
            "in": "query",
            "required": false,
            "description": "Set to 'false' or '0' to disable proxying and retrieve raw URLs when possible.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "noProxy",
            "in": "query",
            "required": false,
            "description": "Set to 'true' or '1' to bypass stream URL proxying.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fProxy",
            "in": "query",
            "required": false,
            "description": "Forward proxy setting (boolean or HTTP proxy string).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stream links retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid tmdbId or provider parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider not found, disabled, or no streams found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server or scraping error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/stream-tv": {
      "get": {
        "summary": "Get TV Episode Stream Links",
        "description": "Fetches validated playback stream links for a TV episode by TMDB ID, season, and episode using a selected provider.",
        "operationId": "getTVStream",
        "tags": ["Streams"],
        "parameters": [
          {
            "name": "tmdbId",
            "in": "query",
            "required": true,
            "description": "The TMDB ID of the TV show (e.g. '2316').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "season",
            "in": "query",
            "required": true,
            "description": "Season number (positive integer).",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "episode",
            "in": "query",
            "required": true,
            "description": "Episode number (positive integer).",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": true,
            "description": "The provider identifier to scrape streams from (e.g. 'vixsrc').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "proxy",
            "in": "query",
            "required": false,
            "description": "Set to 'false' or '0' to disable stream proxying.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "noProxy",
            "in": "query",
            "required": false,
            "description": "Set to 'true' or '1' to bypass stream URL proxying.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fProxy",
            "in": "query",
            "required": false,
            "description": "Forward proxy setting (boolean or HTTP proxy string).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stream links retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid query parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider not found, disabled, or no streams found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server or scraping error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/dlhd/channels": {
      "get": {
        "summary": "List DLHD Live Channels",
        "description": "Scrapes the current 24/7 channel directory from DLHD.",
        "operationId": "getDlhdChannels",
        "tags": ["DLHD"],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Case-insensitive channel name or ID filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "description": "Set to true to bypass the channel cache.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current DLHD channels.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "source", "count", "channels"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "source": {
                      "type": "string",
                      "example": "dlhd"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "channels": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DlhdChannel"
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "DLHD channel directory was unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/dlhd/channels/{id}/stream": {
      "get": {
        "summary": "Extract a DLHD Channel HLS Stream",
        "description": "Resolves a numeric DLHD channel ID to a validated, short-lived M3U8 URL and the Origin, Referer, and User-Agent headers required for playback.",
        "operationId": "getDlhdChannelStream",
        "tags": ["DLHD"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric DLHD channel ID.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "example": "51"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fresh HLS URL and playback headers. The response is not cacheable.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "source",
                    "channel",
                    "stream",
                    "extractedAt"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "source": {
                      "type": "string",
                      "example": "dlhd"
                    },
                    "channel": {
                      "$ref": "#/components/schemas/DlhdChannel"
                    },
                    "stream": {
                      "$ref": "#/components/schemas/DlhdStream"
                    },
                    "extractedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The channel ID is not numeric.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "No current playable M3U8 could be extracted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/dlhd/epg": {
      "get": {
        "summary": "Get the Categorized DLHD EPG",
        "description": "Returns the DLHD schedule grouped by day, category, event, and playable channels.",
        "operationId": "getDlhdEpg",
        "tags": ["DLHD"],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Schedule date in YYYY-MM-DD format.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Case-insensitive category filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search event titles, times, and channel names.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "description": "Set to true to bypass the EPG cache.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Categorized DLHD EPG.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DlhdEpgResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "DLHD EPG was unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/proxy": {
      "get": {
        "summary": "Proxy Video Stream",
        "description": "Proxies video files, HLS manifests/segments, or DASH manifests using a signed JWT/HMAC token to pass required custom headers.",
        "operationId": "proxyStream",
        "tags": ["Proxy"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Signed base64url token containing stream URL, headers, expiration, and HLS/DASH filter directives.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Video stream content (M3U8, MPD, TS segment, or MP4 video).",
            "content": {
              "application/x-mpegURL": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/MP2T": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/dash+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or expired proxy token.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden destination protocol or address.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "502": {
            "description": "Upstream server communication error.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IntroConfig": {
        "type": "object",
        "required": ["enabled", "url"],
        "properties": {
          "enabled": {
            "type": "boolean",
            "example": true
          },
          "url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://cdn.example.com/flixquest-intro.mp4"
          }
        }
      },
      "IntroConfigResponse": {
        "type": "object",
        "required": ["success", "intro"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "intro": {
            "$ref": "#/components/schemas/IntroConfig"
          }
        }
      },
      "ProviderInfo": {
        "type": "object",
        "required": ["id", "name", "alias", "enabled"],
        "properties": {
          "id": {
            "type": "string",
            "example": "vixsrc"
          },
          "name": {
            "type": "string",
            "example": "VixSrc"
          },
          "alias": {
            "type": "string",
            "example": "VixSrc"
          },
          "enabled": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ProviderListResponse": {
        "type": "object",
        "required": ["success", "providers"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderInfo"
            }
          }
        }
      },
      "ProviderHealthResult": {
        "type": "object",
        "required": ["id", "alias", "status", "requestTimeMs"],
        "properties": {
          "id": { "type": "string", "example": "vixsrc" },
          "alias": { "type": "string", "example": "VixSrc" },
          "status": { "type": "string", "enum": ["online", "offline"] },
          "requestTimeMs": { "type": "integer", "example": 1432 }
        }
      },
      "ProviderHealthResponse": {
        "type": "object",
        "required": ["success", "updatedAt", "intervalMs", "summary", "providers"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "startedAt": { "type": "string", "format": "date-time", "nullable": true },
          "updatedAt": { "type": "string", "format": "date-time", "nullable": true },
          "intervalMs": { "type": "integer", "example": 900000 },
          "methodology": { "type": "string" },
          "summary": {
            "type": "object",
            "required": ["total", "online", "offline"],
            "properties": {
              "total": { "type": "integer" },
              "online": { "type": "integer" },
              "offline": { "type": "integer" }
            }
          },
          "providers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProviderHealthResult" }
          }
        }
      },
      "UpdateProviderRequest": {
        "type": "object",
        "required": ["enabled"],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "True to enable provider, false to disable.",
            "example": true
          }
        }
      },
      "ToggleProviderRequest": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Optional boolean to set status. If omitted, status will be toggled.",
            "example": true
          }
        }
      },
      "UpdateProviderResponse": {
        "type": "object",
        "required": ["success", "message", "provider"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Provider 'vixsrc' has been enabled"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderInfo"
          }
        }
      },
      "MediaInfo": {
        "type": "object",
        "required": ["type", "title", "releaseYear", "tmdbId"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["movie", "show"],
            "example": "movie"
          },
          "title": {
            "type": "string",
            "example": "Hamilton"
          },
          "releaseYear": {
            "type": "integer",
            "example": 2020
          },
          "tmdbId": {
            "type": "string",
            "example": "556574"
          }
        }
      },
      "Subtitle": {
        "type": "object",
        "required": ["file", "label", "kind"],
        "properties": {
          "file": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/subs/en.vtt"
          },
          "label": {
            "type": "string",
            "example": "English"
          },
          "kind": {
            "type": "string",
            "example": "captions"
          },
          "default": {
            "type": "boolean",
            "example": true
          },
          "s": {
            "type": "string",
            "description": "Subtitle identifier code if present.",
            "example": "en"
          }
        }
      },
      "ProviderLink": {
        "type": "object",
        "required": ["server", "url", "isM3U8", "quality", "subtitles"],
        "properties": {
          "server": {
            "type": "string",
            "example": "vixsrc"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "http://localhost:3000/proxy?token=eyJ..."
          },
          "isM3U8": {
            "type": "boolean",
            "example": true
          },
          "isDASH": {
            "type": "boolean",
            "example": false
          },
          "quality": {
            "type": "string",
            "example": "1080p"
          },
          "subtitles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subtitle"
            }
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom HTTP headers required when bypassing the stream proxy."
          },
          "hlsVariant": {
            "type": "string",
            "description": "Internal proxy instruction for HLS master playlist variant filtering."
          },
          "hlsAudioLanguage": {
            "type": "string",
            "description": "Internal proxy instruction for default HLS audio language selection."
          },
          "dashVideoHeight": {
            "type": "integer",
            "description": "Internal proxy instruction for DASH video height filtering."
          },
          "requiresProxy": {
            "type": "boolean",
            "description": "Indicates whether anti-hotlink restrictions force this stream through the proxy.",
            "example": false
          }
        }
      },
      "ProviderResponse": {
        "type": "object",
        "required": ["success", "provider"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "provider": {
            "type": "string",
            "example": "vixsrc"
          },
          "media": {
            "$ref": "#/components/schemas/MediaInfo"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderLink"
            }
          },
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "DlhdChannel": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "example": "51"
          },
          "name": {
            "type": "string",
            "example": "ABC USA"
          },
          "letter": {
            "type": "string",
            "example": "A"
          },
          "watchUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://dlhd.st/watch.php?id=51"
          },
          "playerUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://dlhd.st/stream/stream-51.php"
          }
        }
      },
      "DlhdStream": {
        "type": "object",
        "required": ["url", "isM3U8", "headers", "embedUrl"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "A validated, short-lived HLS master playlist URL."
          },
          "isM3U8": {
            "type": "boolean",
            "enum": [true]
          },
          "headers": {
            "type": "object",
            "description": "Headers required for the HLS master, variants, and segments.",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "Accept": "*/*",
              "Origin": "https://player-host.example",
              "Referer": "https://player-host.example/",
              "User-Agent": "Mozilla/5.0 ..."
            }
          },
          "embedUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DlhdEpgResponse": {
        "type": "object",
        "required": [
          "success",
          "source",
          "timezone",
          "dayCount",
          "eventCount",
          "days"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "source": {
            "type": "string",
            "example": "dlhd"
          },
          "timezone": {
            "type": "string",
            "example": "UK GMT"
          },
          "filters": {
            "type": "object",
            "additionalProperties": true
          },
          "dayCount": {
            "type": "integer"
          },
          "eventCount": {
            "type": "integer"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DlhdEpgDay"
            }
          }
        }
      },
      "DlhdEpgDay": {
        "type": "object",
        "required": ["label", "categories"],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "label": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DlhdEpgCategory"
            }
          }
        }
      },
      "DlhdEpgCategory": {
        "type": "object",
        "required": ["name", "slug", "events"],
        "properties": {
          "name": {
            "type": "string",
            "example": "PPV Events"
          },
          "slug": {
            "type": "string",
            "example": "ppv-events"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DlhdEpgEvent"
            }
          }
        }
      },
      "DlhdEpgEvent": {
        "type": "object",
        "required": ["id", "time", "title", "channels"],
        "properties": {
          "id": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "example": "16:00"
          },
          "title": {
            "type": "string",
            "example": "APFC Indian Fight League"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DlhdChannel"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "Missing or invalid tmdbId parameter"
          },
          "details": {
            "type": "string",
            "example": "Available providers: vixsrc, vidsrc, notorrent, ..."
          }
        }
      }
    }
  }
}
